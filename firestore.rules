rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ensure that user data is isolated, allowing only authenticated users to access their own fitness and calorie records.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Match nested calorie or fitness subcollections if they exist
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Explicit match for calorie_records and fitness_records if they are root-level collections referencing user IDs
    match /calorie_records/{recordId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /fitness_records/{recordId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
